# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Lines below are suggestions — uncomment to activate.
# Use ! prefix to force-include something excluded by defaults.
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.
#

# --- Secret material ---

.ua/
.understand-anything/

.secrets/
**/.secrets/

.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

.dev.vars
.dev.vars.*
!.dev.vars.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

*.secret
*.secrets
**/*.secret
**/*.secrets
**/secrets.toml
services/feedback-intake/wrangler.jsonc

# --- Agent / process scaffolding (not PracticeTakes code) ---
# Duplicated OpenSpec skill+command definitions and local agent config.
# These describe how tooling drives the repo, not what the app does.

.claude/
.github/prompts/
.github/skills/

# Issue / PR boilerplate — templates, no architectural signal.
.github/ISSUE_TEMPLATE/
.github/PULL_REQUEST_TEMPLATE.md

# Completed change proposals. Current requirements live in openspec/specs/
# and the active openspec/changes/<name>/ dir, both of which stay indexed.
openspec/changes/archive/

# Generated benchmark output.
benchmark-results/

