# Plaintext secret files to mirror with SOPS.
#
# Patterns are repository-relative globs. Rules are evaluated from top to
# bottom; prefix a rule with ! to exclude a match. Keep example/template files
# excluded because they are safe to commit as plaintext.

.env
.env.*
!.env.example
!.env.*.example

**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

.dev.vars
.dev.vars.*
!.dev.vars.example

**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

*.secret
*.secrets
**/*.secret
**/*.secrets

# The deployed Worker configuration is managed as a secret; the tracked
# template is services/feedback-intake/wrangler.example.jsonc.
services/feedback-intake/wrangler.jsonc

# A directory literally named secrets/ should behave the way a contributor
# expects: everything below it stays local and is mirrored encrypted.
secrets/**
