<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  A score that imports successfully and has something to say about it.

  Every construct here is real MusicXML that this importer treats in one of the
  three ways the summary groups by, so the capture of this score shows all three
  groups at once:

    unsupported  <slur> and <articulations>, recognised and deliberately dropped
    repaired     a metronome mark that disagrees with the playback tempo
    info         six elements the importer has no knowledge of at all

  That last group is the point of the fixture. Every one of those six lines
  carries the same message -- "The importer does not read this element, so it
  was ignored." -- and the element name is the only thing distinguishing them.
  A real MuseScore 4.7.3 export once rendered seven such rows naming nothing;
  this is the picture that would have caught it.
-->
<score-partwise version="4.0">
  <work>
    <work-title>Study in Dropped Content</work-title>
  </work>
  <identification>
    <creator type="composer">Practice Takes</creator>
    <encoding>
      <software>Hand-written fixture</software>
      <encoding-date>2026-10-12</encoding-date>
    </encoding>
    <rights>BSD-3-Clause, with this repository</rights>
    <miscellaneous>
      <miscellaneous-field name="description">Two elements the importer has never heard of.</miscellaneous-field>
    </miscellaneous>
  </identification>
  <part-list>
    <score-part id="P1">
      <part-name>Flute</part-name>
      <part-abbreviation>Fl.</part-abbreviation>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key><fifths>1</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above">
        <direction-type>
          <metronome>
            <beat-unit>quarter</beat-unit>
            <per-minute>60</per-minute>
          </metronome>
        </direction-type>
        <footnote>An engraver's note, which the importer does not read.</footnote>
        <level>1</level>
        <sound tempo="120"/>
      </direction>
      <note>
        <pitch><step>G</step><octave>5</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <notations>
          <slur type="start" number="1"/>
          <articulations><staccato/></articulations>
        </notations>
      </note>
      <note>
        <pitch><step>A</step><octave>5</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <notations>
          <slur type="stop" number="1"/>
          <glissando type="start" number="1"/>
        </notations>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>B</step><octave>5</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <notations>
          <glissando type="stop" number="1"/>
          <arpeggiate/>
        </notations>
      </note>
      <note>
        <pitch><step>G</step><octave>5</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <notations>
          <articulations><tenuto/></articulations>
        </notations>
      </note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
  </part>
</score-partwise>
