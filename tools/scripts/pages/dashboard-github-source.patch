diff --git a/understand-anything-plugin/packages/dashboard/src/utils/sourceLink.ts b/understand-anything-plugin/packages/dashboard/src/utils/sourceLink.ts
new file mode 100644
index 0000000..6e4060d
--- /dev/null
+++ b/understand-anything-plugin/packages/dashboard/src/utils/sourceLink.ts
@@ -0,0 +1,26 @@
+import type { GraphNode } from "@understand-anything/core/types";
+
+/**
+ * Where a node's source lives on GitHub, or null when the build was not given a
+ * repository to link to. The static site has no server to read files from, so
+ * "Open code" links out instead; the dev server leaves the repository unset and
+ * keeps its in-app viewer.
+ *
+ * Pinned to the commit the graph describes rather than a branch, so a line
+ * range from the graph still points at the lines it was measured against.
+ */
+export function githubSourceUrl(
+  repoUrl: string | undefined,
+  commit: string | undefined,
+  node: Pick<GraphNode, "filePath" | "lineRange">,
+): string | null {
+  if (!repoUrl || !node.filePath) return null;
+  const ref = commit && /^[0-9a-f]{7,40}$/i.test(commit) ? commit : "HEAD";
+  const path = node.filePath
+    .replace(/^(\.?\/)+/, "")
+    .split("/")
+    .map(encodeURIComponent)
+    .join("/");
+  const lines = node.lineRange ? `#L${node.lineRange[0]}-L${node.lineRange[1]}` : "";
+  return `${repoUrl.replace(/\/+$/, "")}/blob/${ref}/${path}${lines}`;
+}
